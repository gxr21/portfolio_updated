# Email delivery (Resend)
RESEND_API_KEY=re_your_key
RESEND_FROM=Your Name <onboarding@resend.dev>
CONTACT_EMAIL=Your Email 

# Visitor counter (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token

# Optional Arcjet protection
ARCJET_KEY=your_arcjet_key

# Course lesson uploads. Set the same value in Render so the upload button accepts videos.
COURSE_UPLOAD_KEY=choose-a-long-secret
